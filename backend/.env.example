# ---- Google Gemini / ADK (Vertex AI, authenticated via ADC / Cloud Run IAM) ----
# Local: run `gcloud auth application-default login` first.
# Cloud Run: no credentials needed — the service account handles auth.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Model used by every ADK agent
GEMINI_MODEL=gemini-2.5-flash

# Embedding model for RAG retrieval (JSON MVP -> Vertex Vector Search later)
EMBEDDING_MODEL=text-embedding-004

# How many schemes the recommendation agent returns
RAG_TOP_K=8

# ---- Flask ----
FLASK_PORT=8080
FLASK_DEBUG=1
